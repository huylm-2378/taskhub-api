# Copy to .env and replace the local development password.
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=taskhub
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://taskhub:change_me_local_only@localhost:5432/taskhub
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Tolerance for issued-at clock skew only; token expiry stays strict (0-30 seconds).
JWT_IAT_LEEWAY_SECONDS=5
# Exact frontend origins, comma separated (no trailing slash, no wildcard).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
# Docker publishes on localhost by default; use 0.0.0.0 for direct remote access.
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
# Email is disabled until an SMTP server is configured.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@taskhub.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=5
# Optional local SMTP inbox: docker compose --profile mail up -d mailpit
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
# Optional: docker compose --profile cache up -d --wait redis
# Set REDIS_URL=redis://localhost:6379/0 to enable caching.
REDIS_URL=
# For the containerized app, use redis://redis:6379/0 and enable profile cache.
DOCKER_REDIS_URL=
REDIS_PORT=6379
TAGS_CACHE_TTL_SECONDS=60
TAGS_CACHE_PREFIX=taskhub:tags:v1
